# Copy this file to ".env" and fill in your values.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sakary_cafe

# Port the Express server listens on
PORT=5000

# Allowed CORS origin (your React dev/prod URL)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# The single Admin password (change this to whatever you like)
ADMIN_PASSWORD=admin123
